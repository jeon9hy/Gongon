# 비밀 값: 실제 키는 커밋하지 않는다. 변수 이름은 .env.example에 둔다.
.env
.env.*
!.env.example

# Python / 도구 캐시
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 편집기·OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# 도구별 로컬 설정(공통 규칙은 AGENTS.md에만 둔다)
.claude/settings.local.json
CLAUDE.local.md

# 로컬 바로가기(PC 절대 경로 포함)
*.lnk

# 로컬 작업 산출물(보고서 PDF·캡처·임시 스크립트)
output/
tmp/

# 올린 파일(대화방 사진 등, D-111)
data/
