# 변수 이름만 둔다. 실제 값은 .env(커밋 금지)에 넣는다. 설명: docs/setup.md

# 기상청 단기예보 인증키. 둘 중 하나만 있으면 된다(둘 다 있으면 API허브 우선). 없으면 판정이 '판정 불가'로 기록된다.
# 기상청 API허브(apihub.kma.go.kr) authKey — 예특보 > 단기예보 조회서비스 활용신청 필요
KMA_APIHUB_KEY=
# 공공데이터포털 "일반 인증키(Decoding)". 중기예보 조회서비스도 같은 키로 쓴다(활용신청 필요, D-042)
KMA_SERVICE_KEY=

# 매시 15분 전체 현장 자동 판정(D-043). 끄려면 0. 비우면 켜짐
AUTO_REFRESH=

# 로그인 쿠키를 HTTPS에서만 보내려면 1 (시연 배포). 로컬 http 개발은 비워 둔다 (D-057)
SESSION_COOKIE_SECURE=

# PostgreSQL 연결 문자열. 개발은 로컬 PostgreSQL, 시연 배포는 Supabase (D-014)
# 예: postgresql://postgres:<비밀번호>@localhost:5432/gongon
DATABASE_URL=

# 현장 위치 찾기(선택): 카카오 로컬 API REST API 키. 없으면 위도·경도를 직접 입력한다(D-022)
KAKAO_REST_API_KEY=

# DB 테스트용(선택). 이름에 test가 들어간 별도 DB. 테스트가 스키마를 지우고 다시 만든다.
# 예: postgresql://postgres:<비밀번호>@localhost:5432/gongon_test
TEST_DATABASE_URL=

# 기준 원문 발췌 스크립트용(앱은 안 씀). 국가법령정보 OC(open.law.go.kr), 국가건설기준센터 OpenAPI 키(kcsc.re.kr/support/api)
LAW_OC=
KCSC_API_KEY=

# 카카오 알림톡: 사업자 등록 후 추가 (D-015). 현재는 변수 없음

# 대화방 사진 보관 폴더(D-111). 비우면 저장소의 data/uploads
UPLOAD_DIR=
